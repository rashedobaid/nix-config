{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.12.0",
  "schemes" : [
    {
      "buttons" : {
        "universalBackForward" : true
      },
      "if" : {
        "device" : {
          "category" : "mouse"
        }
      },
      "pointer" : {
        "acceleration" : 1,
        "disableAcceleration" : true
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : "auto"
        },
        "reverse" : {
          "vertical" : true
        },
        "smoothed" : {
          "vertical" : {
            "enabled" : false
          }
        },
        "speed" : {
          "vertical" : 0
        }
      }
    }
  ]
}
